{
  "name": "cloud-functions",
  "description": "Firebase Cloud Functions",
  "dependencies": {
    "firebase-admin": "14.2.0",
    "firebase-functions": "7.3.2"
  },
  "scripts": {
    "check": "node --check index.js",
    "serve": "firebase -P lotus-lxr3lu emulators:start --only functions",
    "shell": "firebase -P lotus-lxr3lu functions:shell",
    "start": "npm run shell",
    "logs": "firebase -P lotus-lxr3lu functions:log",
    "deploy": "firebase -P lotus-lxr3lu deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "private": true
}
